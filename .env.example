NEXT_PUBLIC_API_URL=http://localhost:4000

# Google — Client ID OAuth 2.0 (même valeur que GOOGLE_OAUTH_CLIENT_ID côté backend), utilisé
# par Google Identity Services pour le bouton "Continuer avec Google" du login. Le Client ID
# est public par nature (visible dans le code du navigateur), aucun secret ici.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
